# ==============================================================================
# Messaging Platform Ecosystem - Environment Variables Template
# ==============================================================================

# ─── Global Environment & Zero Outbound Leakage Guard ─────────────────────────
# When DEV_MODE=true and APP_DEV_MODE=true, outbound SMTP port 25 and external
# SMS/Kakao/Push APIs are mocked/intercepted in memory without external leakage.
DEV_MODE=true
APP_DEV_MODE=true
TZ=Asia/Seoul

# ─── MariaDB Database Configuration ──────────────────────────────────────────
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=messagedb
DB_USER=root
DB_ROOT_PASSWORD=root

# ─── Redis Cache & In-Memory Store ────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Apache ActiveMQ Message Broker ───────────────────────────────────────────
ACTIVEMQ_HOST=activemq
ACTIVEMQ_JMS_PORT=61616
ACTIVEMQ_WEB_PORT=8161
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=admin

# ─── Microservice Exposed Host Ports ──────────────────────────────────────────
BACKEND_PORT=8083
TARGETING_PORT=8080
PAYLOADER_PORT=8084
DISPATCHER_PORT=8081
FAILOVER_PORT=8085
FRONTEND_PORT=3000

# ─── Distributed Logger Daemon ────────────────────────────────────────────────
LOGGER_TCP_PORT=9876
LOGGER_BATCH_SIZE=1000
LOGGER_FLUSH_INTERVAL_MS=3000

# ─── Observability (Prometheus & Grafana) ─────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ─── External Channel API Harness (Mocks enabled in DEV_MODE) ─────────────────
ALIGO_API_KEY=mock-aligo-api-key
ALIGO_USER_ID=mock-aligo-user
ALIGO_SENDER=02-1234-5678
COOLSMS_API_KEY=mock-coolsms-api-key
COOLSMS_API_SECRET=mock-coolsms-secret
COOLSMS_SENDER=02-1234-5678
RCS_BRAND_ID=BR-MODOO-2026
RCS_CHATBOT_ID=1588-0000
RCS_API_KEY=mock-rcs-api-key
