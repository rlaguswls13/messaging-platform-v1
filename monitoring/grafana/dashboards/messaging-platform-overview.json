    {
      "id": 4,
      "title": "발송 처리 지연시간 (Latency ms) [95th 백분위]",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "채널별 발송 처리 지연시간 95th 백분위 (P95) 및 평균(Avg) 추이 (ms 단위)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(messaging_dispatch_duration_seconds_bucket[1m])) by (le, channel)) * 1000",
          "legendFormat": "p95 {{channel}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(messaging_dispatch_duration_seconds_sum[1m])) by (channel) / clamp_min(sum(rate(messaging_dispatch_duration_seconds_count[1m])) by (channel), 0.001)) * 1000",
          "legendFormat": "avg {{channel}}",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "last"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
